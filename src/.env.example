# Server Configuration
NODE_ENV=development
PORT=3000

# Cache Settings
CACHE_DURATION=30 seconds

# Server Query Timeouts
QUERY_TIMEOUT=5000
QUAKE_DELAY=450

# Rate Limiting
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW=5  # Window in minutes
RATE_LIMIT_MAX=200   # Max requests per window

# Logging
# LOG_LEVEL=debug  # Optional: Override default (debug in dev, info in production)
